{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hotkit configuration",
  "description": "See docs/configuration.md. Comments and trailing commas are allowed in the actual file.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "watchConfig": {
          "type": "boolean",
          "description": "Restart when the config file or plugin folder changes."
        },
        "debug": {
          "type": "boolean"
        },
        "keyboard": {
          "type": "object",
          "properties": {
            "capsLock": {
              "$ref": "#/$defs/lockState"
            },
            "numLock": {
              "$ref": "#/$defs/lockState"
            }
          },
          "additionalProperties": false
        }
      }
    },
    "modifiers": {
      "type": "object",
      "description": "Keys that act as modifiers while physically held.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "suspendWhenActive": {
            "description": "WinTitle(s) that pause the modifier while active, e.g. windows that scramble keystrokes sent to keyboard hooks.",
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "layers": {
      "description": "Switchable sets of bindings; exactly one is active at a time. A list of names, or an object of name -> settings (listed in natural order).",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ],
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Shown in toasts, the tray menu and the shortcut overlay."
              },
              "description": {
                "type": "string"
              },
              "default": {
                "type": "boolean",
                "description": "Start on this layer (default: the first)."
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "groups": {
      "type": "object",
      "description": "Named binding groups that can be toggled at runtime.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "object",
      "description": "Per-module settings. Any module accepts { \"enabled\": false }.",
      "properties": {
        "displayBrightness": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "swapFallback": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "gamma": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              }
            }
          }
        },
        "displayScale": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "setDpiPath": {
              "type": "string"
            },
            "presets": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 100,
                "maximum": 500
              }
            },
            "debounceMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "alwaysOnTop": {
          "type": "object",
          "properties": {
            "indicatorColor": {
              "type": "string",
              "pattern": "^([0-9A-Fa-f]{6})?$"
            }
          }
        },
        "theme": {
          "type": "object",
          "properties": {
            "bing": {
              "type": "object",
              "properties": {
                "cacheDir": {
                  "type": "string"
                },
                "maxAgeDays": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "wallpaper": {
              "type": "object",
              "properties": {
                "light": {
                  "type": "string"
                },
                "dark": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "power": {
          "type": "object",
          "description": "Stay-awake toggles and monitors.off. On unless { \"enabled\": false }.",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "trayIcons": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "intervalSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "taskSwitcher": {
          "type": "object",
          "properties": {
            "ignore": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "exe": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "emptyTitle": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "windowRules": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pollMs": {
              "type": "integer",
              "minimum": 50
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "match",
                  "alwaysOnTop"
                ],
                "properties": {
                  "match": {
                    "type": "string",
                    "description": "WinTitle"
                  },
                  "alwaysOnTop": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "apps": {
      "type": "object",
      "description": "Apps used by app.toggle / app.launch.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "run"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "type": "string"
          },
          "options": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "quickWindows": {
      "type": "object",
      "description": "Generic floating windows summoned by quickWindow.* actions.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "exe"
        ],
        "properties": {
          "exe": {
            "type": "string",
            "minLength": 1
          },
          "launch": {
            "type": "string"
          },
          "match": {
            "$ref": "#/$defs/windowMatch"
          },
          "toolWindow": {
            "type": "boolean"
          },
          "alwaysOnTop": {
            "type": "boolean"
          },
          "claimExisting": {
            "type": "boolean"
          },
          "multipleWindows": {
            "type": "boolean"
          },
          "launchTimeoutSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "size": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "modes": {
            "type": "array",
            "description": "Values substituted for {mode} in launch; cycled by quickWindow.cycleMode.",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "tray": {
      "type": "object",
      "properties": {
        "icon": {
          "description": "Tray icon. Omit for the bundled hotkit icon. A path to an .ico, .dll or .exe (relative paths resolve next to config.json; bare names like shell32.dll also search System32), or { file, index } to pick an icon from a multi-icon file. An unusable icon falls back to the default and is listed as a config problem.",
          "oneOf": [
            {
              "type": [
                "string",
                "null"
              ]
            },
            {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "index": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  },
                  "description": "1-based icon number in the file; negative for a resource ID."
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "items": {
          "$ref": "#/$defs/trayItems"
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "object",
      "description": "Settings for plugins, keyed by plugin name. Opaque to the core.",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "lockState": {
      "enum": [
        "On",
        "Off",
        "AlwaysOn",
        "AlwaysOff",
        ""
      ]
    },
    "actionRef": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string"
            },
            "args": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "windowMatch": {
      "type": "object",
      "properties": {
        "exe": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "titleNotEmpty": {
          "type": "boolean"
        },
        "appUserModelId": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "topLevel": {
          "type": "boolean"
        },
        "minWidth": {
          "type": "integer",
          "minimum": 0
        },
        "minHeight": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string"
        },
        "args": {
          "type": "array"
        },
        "gestures": {
          "type": "object",
          "properties": {
            "tap": {
              "$ref": "#/$defs/actionRef"
            },
            "doubleTap": {
              "$ref": "#/$defs/actionRef"
            },
            "hold": {
              "$ref": "#/$defs/actionRef"
            },
            "holdMs": {
              "type": "integer",
              "minimum": 50
            },
            "doubleTapMs": {
              "type": "integer",
              "minimum": 50
            }
          },
          "additionalProperties": false
        },
        "onRelease": {
          "$ref": "#/$defs/actionRef",
          "description": "Run when the key, or the binding's modifier key, is released (press-and-hold)."
        },
        "onNextKey": {
          "$ref": "#/$defs/actionRef",
          "description": "Run on the next press of any other key, which is consumed (press, then latch until the next key)."
        },
        "onCancel": {
          "$ref": "#/$defs/actionRef",
          "description": "With onNextKey: run instead when the next key is Escape."
        },
        "exclusive": {
          "type": "string",
          "minLength": 1,
          "description": "Shared by hold and latch bindings: while one is active, pressing another stops it instead of starting."
        },
        "waitRelease": {
          "type": "boolean"
        },
        "modifier": {
          "type": "string",
          "description": "Name from 'modifiers'; only active while its key is held."
        },
        "layer": {
          "description": "Layer name or list of names from 'layers'; only active on those layers. Omitted: every layer.",
          "oneOf": [
            {
              "type": [
                "string",
                "integer"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "minItems": 1
            }
          ]
        },
        "group": {
          "type": "string"
        },
        "whenActive": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "action"
          ],
          "not": {
            "required": [
              "gestures"
            ]
          }
        },
        {
          "required": [
            "gestures"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "action"
                ]
              },
              {
                "required": [
                  "onRelease"
                ]
              },
              {
                "required": [
                  "onNextKey"
                ]
              },
              {
                "required": [
                  "onCancel"
                ]
              }
            ]
          }
        }
      ],
      "not": {
        "required": [
          "onRelease",
          "onNextKey"
        ]
      },
      "dependentRequired": {
        "onCancel": [
          "onNextKey"
        ]
      },
      "additionalProperties": false
    },
    "trayItems": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "separator"
            ],
            "properties": {
              "separator": {
                "const": true
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "label",
              "items"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "items": {
                "$ref": "#/$defs/trayItems"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "label",
              "action"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "args": {}
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
