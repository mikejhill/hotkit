{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "hotkit configuration",
  "allowComments": true,
  "allowTrailingCommas": true,
  "description": "See docs/configuration.md. Comments and trailing commas are allowed in the actual file.",
  "type": "object",
  "properties": {
    "$schema": {
      "type": "string"
    },
    "settings": {
      "type": "object",
      "properties": {
        "watchConfig": {
          "type": "boolean",
          "description": "Restart when the config file or plugin folder changes."
        },
        "updates": {
          "type": "object",
          "description": "Look for new hotkit releases on GitHub and install them into the git checkout hotkit runs from.",
          "properties": {
            "check": { "type": "boolean", "description": "Look for new releases (default true)." },
            "apply": { "enum": ["manual", "auto"], "description": "manual (default): offer tray › Update to vX.Y.Z. auto: install and reload once you're idle." },
            "intervalHours": { "type": "number", "minimum": 1, "maximum": 720, "description": "Hours between checks (default 6, at most 720)." },
            "repository": { "type": "string", "pattern": "^[\\w.-]+/[\\w.-]+$", "description": "GitHub owner/name to follow (default mikejhill/hotkit)." }
          },
          "additionalProperties": false
        },
        "ignoreSimulatedKeys": {
          "type": "boolean",
          "description": "Shortcuts ignore keystrokes that programs simulate (default true); set allowSimulated on bindings fed by such programs."
        },
        "suspendWhenActive": {
          "oneOf": [
            { "type": "string", "minLength": 1 },
            { "type": "array", "items": { "type": "string", "minLength": 1 } }
          ],
          "description": "WinTitle(s) that get the keyboard to themselves: while one is active, every shortcut (layer keys included) is suspended and a forced capsLock/numLock state is lifted, so the window sees those keys as typed."
        },
        "remoteWindows": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 },
          "description": "WinTitles of remote session clients (Remote Desktop, virtual desktop viewers). There hotkit keeps its hook ahead of the client's, passes held modifiers on as their remoteKey, and keys no local binding takes reach the remote machine."
        },
        "debug": {
          "type": "boolean"
        },
        "keyboard": {
          "type": "object",
          "properties": {
            "capsLock": {
              "$ref": "#/$defs/lockState"
            },
            "numLock": {
              "$ref": "#/$defs/lockState"
            },
            "keepWhileSuspended": {
              "type": "boolean",
              "description": "Keep a forced capsLock/numLock state while a settings.suspendWhenActive window is active: the key still reaches the window, and the toggle it causes is set back after release (default false)."
            }
          },
          "additionalProperties": false
        }
      }
    },
    "modifiers": {
      "type": "object",
      "description": "Keys that act as modifiers while physically held.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "key"
        ],
        "properties": {
          "key": {
            "type": "string",
            "minLength": 1
          },
          "label": {
            "type": "string"
          },
          "remoteKey": {
            "type": "string",
            "minLength": 1,
            "description": "Key that stands in for this modifier across remote sessions, e.g. F18. In a settings.remoteWindows window, holding the modifier holds this key in the session; a hotkit receiving it treats it as the modifier."
          },
          "suspendWhenActive": {
            "description": "WinTitle(s) that pause the modifier while active, e.g. windows that scramble keystrokes sent to keyboard hooks.",
            "oneOf": [
              {
                "type": "string",
                "minLength": 1
              },
              {
                "type": "array",
                "items": {
                  "type": "string",
                  "minLength": 1
                }
              }
            ]
          }
        },
        "additionalProperties": false
      }
    },
    "layers": {
      "description": "Switchable sets of bindings; exactly one is active at a time. A list of names, or an object of name -> settings (listed in natural order).",
      "oneOf": [
        {
          "type": "array",
          "items": {
            "type": [
              "string",
              "integer"
            ],
            "minLength": 1
          },
          "uniqueItems": true
        },
        {
          "type": "object",
          "additionalProperties": {
            "type": "object",
            "properties": {
              "label": {
                "type": "string",
                "description": "Shown in toasts, the tray menu and the shortcut overlay."
              },
              "description": {
                "type": "string"
              },
              "default": {
                "type": "boolean",
                "description": "Start on this layer (default: the first)."
              }
            },
            "additionalProperties": false
          }
        }
      ]
    },
    "groups": {
      "type": "object",
      "description": "Named binding groups that can be toggled at runtime.",
      "additionalProperties": {
        "type": "object",
        "properties": {
          "description": {
            "type": "string"
          },
          "enabled": {
            "type": "boolean"
          }
        },
        "additionalProperties": false
      }
    },
    "modules": {
      "type": "object",
      "description": "Per-module settings. Any module accepts { \"enabled\": false }.",
      "properties": {
        "displayBrightness": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "step": {
              "type": "number",
              "exclusiveMinimum": 0,
              "maximum": 100
            },
            "swapFallback": {
              "type": "number",
              "minimum": 0,
              "maximum": 100
            },
            "gamma": {
              "type": "object",
              "properties": {
                "default": {
                  "type": "number"
                },
                "min": {
                  "type": "number"
                },
                "max": {
                  "type": "number"
                }
              }
            }
          }
        },
        "displayScale": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "setDpiPath": {
              "type": "string"
            },
            "presets": {
              "type": "array",
              "items": {
                "type": "number",
                "minimum": 100,
                "maximum": 500
              }
            },
            "debounceMs": {
              "type": "integer",
              "minimum": 0
            }
          }
        },
        "alwaysOnTop": {
          "type": "object",
          "properties": {
            "indicatorColor": {
              "type": "string",
              "pattern": "^([0-9A-Fa-f]{6})?$"
            }
          }
        },
        "theme": {
          "type": "object",
          "properties": {
            "bing": {
              "type": "object",
              "properties": {
                "cacheDir": {
                  "type": "string"
                },
                "maxAgeDays": {
                  "type": "number",
                  "minimum": 0
                }
              },
              "additionalProperties": false
            },
            "wallpaper": {
              "type": "object",
              "properties": {
                "light": {
                  "type": "string"
                },
                "dark": {
                  "type": "string"
                }
              },
              "additionalProperties": false
            }
          }
        },
        "power": {
          "type": "object",
          "description": "Stay-awake toggles and monitors.off. On unless { \"enabled\": false }.",
          "properties": {
            "enabled": {
              "type": "boolean"
            }
          }
        },
        "trayIcons": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "intervalSeconds": {
              "type": "number",
              "exclusiveMinimum": 0
            }
          }
        },
        "taskSwitcher": {
          "type": "object",
          "properties": {
            "ignore": {
              "type": "array",
              "items": {
                "type": "object",
                "properties": {
                  "exe": {
                    "type": "string"
                  },
                  "title": {
                    "type": "string"
                  },
                  "emptyTitle": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        },
        "windowCycle": {
          "type": "object",
          "properties": {
            "continueMs": {
              "type": "integer",
              "minimum": 0,
              "maximum": 60000,
              "description": "Keep a window.cycleNext/cyclePrevious cycle open this long after its keys are released, so the next press continues it. 0 ends it on release."
            }
          },
          "additionalProperties": false
        },
        "windowRules": {
          "type": "object",
          "properties": {
            "enabled": {
              "type": "boolean"
            },
            "pollMs": {
              "type": "integer",
              "minimum": 50
            },
            "rules": {
              "type": "array",
              "items": {
                "type": "object",
                "required": [
                  "match",
                  "alwaysOnTop"
                ],
                "properties": {
                  "match": {
                    "type": "string",
                    "description": "WinTitle"
                  },
                  "alwaysOnTop": {
                    "type": "boolean"
                  }
                },
                "additionalProperties": false
              }
            }
          }
        }
      },
      "additionalProperties": {
        "type": "object"
      }
    },
    "apps": {
      "type": "object",
      "description": "Apps used by app.toggle / app.launch.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "run"
        ],
        "properties": {
          "name": {
            "type": "string"
          },
          "run": {
            "type": "string",
            "minLength": 1
          },
          "match": {
            "type": "string"
          },
          "options": {
            "type": "string"
          }
        },
        "additionalProperties": false
      }
    },
    "quickWindows": {
      "type": "object",
      "description": "Generic floating windows summoned by quickWindow.* actions.",
      "additionalProperties": {
        "type": "object",
        "required": [
          "exe"
        ],
        "properties": {
          "exe": {
            "type": "string",
            "minLength": 1
          },
          "launch": {
            "type": "string"
          },
          "match": {
            "$ref": "#/$defs/windowMatch"
          },
          "toolWindow": {
            "type": "boolean"
          },
          "alwaysOnTop": {
            "type": "boolean"
          },
          "claimExisting": {
            "type": "boolean"
          },
          "multipleWindows": {
            "type": "boolean"
          },
          "launchTimeoutSeconds": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "size": {
            "type": "object",
            "properties": {
              "width": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              },
              "height": {
                "type": "number",
                "exclusiveMinimum": 0,
                "maximum": 1
              }
            },
            "additionalProperties": false
          },
          "modes": {
            "type": "array",
            "description": "Values substituted for {mode} in launch; cycled by quickWindow.cycleMode.",
            "items": {
              "type": "string"
            }
          }
        },
        "additionalProperties": false
      }
    },
    "bindings": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/binding"
      }
    },
    "schedules": {
      "type": "array",
      "description": "Actions to run on a cron schedule, at an interval, or on events such as startup, lock, and unlock.",
      "items": {
        "$ref": "#/$defs/schedule"
      }
    },
    "tray": {
      "type": "object",
      "properties": {
        "icon": {
          "description": "Tray icon. Omit for the bundled hotkit icon. A path to an .ico, .dll or .exe (relative paths resolve next to config.json; bare names like shell32.dll also search System32), or { file, index } to pick an icon from a multi-icon file. An unusable icon falls back to the default and is listed as a config problem.",
          "oneOf": [
            {
              "type": [
                "string",
                "null"
              ]
            },
            {
              "type": "object",
              "required": [
                "file"
              ],
              "properties": {
                "file": {
                  "type": "string"
                },
                "index": {
                  "type": "integer",
                  "not": {
                    "const": 0
                  },
                  "description": "1-based icon number in the file; negative for a resource ID."
                }
              },
              "additionalProperties": false
            }
          ]
        },
        "items": {
          "$ref": "#/$defs/trayItems"
        }
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "object",
      "description": "Settings for plugins, keyed by plugin name. Opaque to the core.",
      "additionalProperties": {
        "type": "object"
      }
    }
  },
  "additionalProperties": false,
  "$defs": {
    "lockState": {
      "enum": [
        "On",
        "Off",
        "AlwaysOn",
        "AlwaysOff",
        ""
      ]
    },
    "actionRef": {
      "oneOf": [
        {
          "type": "string",
          "pattern": "^[A-Za-z][A-Za-z0-9]*(\\.[A-Za-z][A-Za-z0-9]*)*$"
        },
        {
          "type": "object",
          "required": [
            "action"
          ],
          "properties": {
            "action": {
              "type": "string"
            },
            "args": {}
          },
          "additionalProperties": false
        }
      ]
    },
    "windowMatch": {
      "type": "object",
      "properties": {
        "exe": {
          "type": "string"
        },
        "class": {
          "type": "string"
        },
        "title": {
          "type": "string"
        },
        "titleNotEmpty": {
          "type": "boolean"
        },
        "appUserModelId": {
          "type": "string"
        },
        "visible": {
          "type": "boolean"
        },
        "topLevel": {
          "type": "boolean"
        },
        "minWidth": {
          "type": "integer",
          "minimum": 0
        },
        "minHeight": {
          "type": "integer",
          "minimum": 0
        }
      },
      "additionalProperties": false
    },
    "binding": {
      "type": "object",
      "required": [
        "keys"
      ],
      "properties": {
        "keys": {
          "type": "string",
          "minLength": 1
        },
        "action": {
          "type": "string"
        },
        "args": {
          "type": "array"
        },
        "gestures": {
          "type": "object",
          "properties": {
            "tap": {
              "$ref": "#/$defs/actionRef"
            },
            "doubleTap": {
              "$ref": "#/$defs/actionRef"
            },
            "hold": {
              "$ref": "#/$defs/actionRef"
            },
            "holdMs": {
              "type": "integer",
              "minimum": 50
            },
            "doubleTapMs": {
              "type": "integer",
              "minimum": 50
            }
          },
          "additionalProperties": false
        },
        "onRelease": {
          "$ref": "#/$defs/actionRef",
          "description": "Run when the key, or the binding's modifier key, is released (press-and-hold)."
        },
        "onNextKey": {
          "$ref": "#/$defs/actionRef",
          "description": "Run on the next press of any other key, which is consumed (press, then latch until the next key)."
        },
        "onCancel": {
          "$ref": "#/$defs/actionRef",
          "description": "With onNextKey: run instead when the next key is Escape."
        },
        "exclusive": {
          "type": "string",
          "minLength": 1,
          "description": "Shared by hold and latch bindings: while one is active, pressing another stops it instead of starting."
        },
        "waitRelease": {
          "type": "boolean"
        },
        "allowSimulated": {
          "type": "boolean",
          "description": "Also fire when a program simulates the keys (mouse utilities, remote machines)."
        },
        "yieldToRemote": {
          "type": "boolean",
          "description": "Stand aside while a window from settings.remoteWindows is active, so the remote machine gets the keys."
        },
        "modifier": {
          "type": "string",
          "description": "Name from 'modifiers'; only active while its key is held."
        },
        "layer": {
          "description": "Layer name or list of names from 'layers'; only active on those layers. Omitted: every layer.",
          "oneOf": [
            {
              "type": [
                "string",
                "integer"
              ]
            },
            {
              "type": "array",
              "items": {
                "type": [
                  "string",
                  "integer"
                ]
              },
              "minItems": 1
            }
          ]
        },
        "group": {
          "type": "string"
        },
        "whenActive": {
          "type": "string"
        },
        "description": {
          "type": "string"
        },
        "enabled": {
          "type": "boolean"
        }
      },
      "oneOf": [
        {
          "required": [
            "action"
          ],
          "not": {
            "required": [
              "gestures"
            ]
          }
        },
        {
          "required": [
            "gestures"
          ],
          "not": {
            "anyOf": [
              {
                "required": [
                  "action"
                ]
              },
              {
                "required": [
                  "onRelease"
                ]
              },
              {
                "required": [
                  "onNextKey"
                ]
              },
              {
                "required": [
                  "onCancel"
                ]
              }
            ]
          }
        }
      ],
      "not": {
        "required": [
          "onRelease",
          "onNextKey"
        ]
      },
      "dependentRequired": {
        "onCancel": [
          "onNextKey"
        ]
      },
      "additionalProperties": false
    },
    "schedule": {
      "type": "object",
      "allOf": [
        {
          "anyOf": [
            {
              "required": [
                "cron"
              ]
            },
            {
              "required": [
                "every"
              ]
            },
            {
              "required": [
                "on"
              ]
            }
          ]
        },
        {
          "oneOf": [
            {
              "required": [
                "action"
              ],
              "not": {
                "required": [
                  "actions"
                ]
              }
            },
            {
              "required": [
                "actions"
              ],
              "not": {
                "required": [
                  "args"
                ]
              }
            }
          ]
        }
      ],
      "properties": {
        "name": {
          "type": "string",
          "description": "Unique name, used by schedule.run and in the status log."
        },
        "description": {
          "type": "string"
        },
        "action": {
          "type": "string",
          "description": "Action id to run. Use 'actions' instead for several steps."
        },
        "args": {
          "type": "array",
          "description": "Positional arguments for the action."
        },
        "actions": {
          "type": "array",
          "minItems": 1,
          "description": "Steps run in order instead of 'action': action ids, { \"action\", \"args\" }, or { \"wait\": \"2s\" } pauses.",
          "items": {
            "oneOf": [
              {
                "$ref": "#/$defs/actionRef"
              },
              {
                "type": "object",
                "required": [
                  "wait"
                ],
                "properties": {
                  "wait": {
                    "type": "string",
                    "pattern": "^(?=[^1-9]*[1-9])\\s*(\\d+\\s*[dD])?\\s*(\\d+\\s*[hH])?\\s*(\\d+\\s*[mM])?\\s*(\\d+\\s*[sS])?\\s*$",
                    "description": "Pause before the next step, such as \"2s\" (at most 24 days). Not allowed with exit or sleep."
                  }
                },
                "additionalProperties": false
              }
            ]
          },
          "contains": {
            "$ref": "#/$defs/actionRef"
          }
        },
        "continueOnError": {
          "type": "boolean",
          "description": "With 'actions': keep running the remaining steps after one fails (default false: stop)."
        },
        "cron": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ],
          "description": "Five-field cron expression in local time (minute hour day month weekday), or a list of them. Shorthands: @hourly, @daily, @weekly, @monthly, @yearly."
        },
        "every": {
          "type": "string",
          "pattern": "^(?=[^1-9]*[1-9])\\s*(\\d+\\s*[dD])?\\s*(\\d+\\s*[hH])?\\s*(\\d+\\s*[mM])?\\s*(\\d+\\s*[sS])?\\s*$",
          "description": "Run repeatedly at this interval, such as \"15m\" or \"1h30m\" (at most 24 days). The first run is one interval after Hotkit starts."
        },
        "on": {
          "description": "Event or list of events that run the action.",
          "oneOf": [
            {
              "enum": [
                "startup",
                "reload",
                "exit",
                "lock",
                "unlock",
                "sleep",
                "resume",
                "idle",
                "active",
                "pluggedIn",
                "unplugged",
                "remoteConnect",
                "remoteDisconnect"
              ]
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "enum": [
                  "startup",
                  "reload",
                  "exit",
                  "lock",
                  "unlock",
                  "sleep",
                  "resume",
                  "idle",
                  "active",
                  "pluggedIn",
                  "unplugged",
                  "remoteConnect",
                  "remoteDisconnect"
                ]
              }
            }
          ]
        },
        "delay": {
          "type": "string",
          "pattern": "^(?=[^1-9]*[1-9])\\s*(\\d+\\s*[dD])?\\s*(\\d+\\s*[hH])?\\s*(\\d+\\s*[mM])?\\s*(\\d+\\s*[sS])?\\s*$",
          "description": "Wait this long after an 'on' event before running. Not allowed with exit or sleep."
        },
        "idleAfter": {
          "type": "string",
          "pattern": "^(?=[^1-9]*[1-9])\\s*(\\d+\\s*[dD])?\\s*(\\d+\\s*[hH])?\\s*(\\d+\\s*[mM])?\\s*(\\d+\\s*[sS])?\\s*$",
          "description": "For idle and active: how long without keyboard or mouse input counts as idle (default \"10m\", at least 10s)."
        },
        "catchUp": {
          "type": "boolean",
          "description": "Run once after waking when a cron time passed while the PC was asleep (default false)."
        },
        "machines": {
          "oneOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "array",
              "minItems": 1,
              "items": {
                "type": "string",
                "minLength": 1
              }
            }
          ],
          "description": "Only load this schedule on these computers (names compared case-insensitively)."
        },
        "enabled": {
          "type": "boolean",
          "description": "false skips the schedule."
        }
      },
      "additionalProperties": false
    },
    "trayItems": {
      "type": "array",
      "items": {
        "oneOf": [
          {
            "type": "object",
            "required": [
              "separator"
            ],
            "properties": {
              "separator": {
                "const": true
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "label",
              "items"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "items": {
                "$ref": "#/$defs/trayItems"
              }
            },
            "additionalProperties": false
          },
          {
            "type": "object",
            "required": [
              "label",
              "action"
            ],
            "properties": {
              "label": {
                "type": "string"
              },
              "action": {
                "type": "string"
              },
              "args": {}
            },
            "additionalProperties": false
          }
        ]
      }
    }
  }
}
