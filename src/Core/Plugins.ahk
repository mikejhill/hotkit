#Requires AutoHotkey v2.0

#Include %A_LineFile%\..\Paths.ahk

; User plugins are .ahk files in <config dir>\plugins\. AutoHotkey resolves
; #Include at load time and cannot read %USERPROFILE%, so Main.ahk includes a
; git-ignored stub (local\plugins.generated.ahk) that lists the plugins by
; absolute path. Sync() rewrites the stub when the plugin set changes and
; reports whether a reload is needed for the change to take effect.
;
; Only top-level *.ahk files are included; put helper libraries for a plugin
; in a subfolder and #Include them from the plugin with %A_LineFile%.
class Plugins {
    static Discover(dir := "") {
        if (dir = "")
            dir := Paths.PluginDir()
        found := []
        if !DirExist(dir)
            return found
        loop files dir "\*.ahk", "F"
            found.Push(A_LoopFileFullPath)
        return Plugins._Sort(found)
    }

    static Render(files) {
        text := "; Generated by hotkit. Do not edit; changes are overwritten.`n"
        text .= "; Plugins come from: " Paths.PluginDir() "`n"
        for path in files
            text .= "#Include *i " path "`n"
        return text
    }

    ; Returns true when the stub changed (caller should Reload()).
    ; True when the stub already includes exactly the plugins in `dir`.
    static IsCurrent(stubPath := "", dir := "") {
        if (stubPath = "")
            stubPath := Paths.PluginStub()
        current := FileExist(stubPath) ? FileRead(stubPath, "UTF-8") : ""
        return current == Plugins.Render(Plugins.Discover(dir))
    }

    static Sync(stubPath := "", dir := "") {
        if (stubPath = "")
            stubPath := Paths.PluginStub()
        if Plugins.IsCurrent(stubPath, dir)
            return false
        wanted := Plugins.Render(Plugins.Discover(dir))
        SplitPath(stubPath, , &stubDir)
        if !DirExist(stubDir)
            DirCreate(stubDir)
        f := FileOpen(stubPath, "w", "UTF-8-RAW")
        f.Write(wanted)
        f.Close()
        return true
    }

    static _Sort(items) {
        text := ""
        for item in items
            text .= item "`n"
        sorted := Sort(RTrim(text, "`n"))
        return sorted = "" ? [] : StrSplit(sorted, "`n")
    }
}
