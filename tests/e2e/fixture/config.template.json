// E2E fixture. {{PROBE}} is replaced by the driver.
{
  "settings": { "watchConfig": true },
  "plugins": { "probe": { "file": "{{PROBE}}" } },
  "groups": { "g": { "enabled": true } },
  "apps": { "e2ewin": { "name": "E2E window", "run": "does-not-exist.exe", "match": "^hotkit-e2e-win " } },
  "quickWindows": { "qw": { "exe": "AutoHotkey64.exe", "launch": "\"{{AHK}}\" \"{{FIXTURE}}\\ShowQw.ahk\"",
    "match": { "title": "^hotkit-e2e-qw$", "visible": true }, "claimExisting": true } },
  "bindings": [
    { "keys": ">^>!F20", "action": "probe.mark", "args": ["simple"] },
    { "keys": ">^>!F19", "action": "probe.mark", "args": ["grouped"], "group": "g" },
    { "keys": ">^>!F18", "action": "bindings.toggleGroup", "args": ["g"] },
    { "keys": ">^>!F17", "gestures": {
        "tap": { "action": "probe.mark", "args": ["tap"] },
        "doubleTap": { "action": "probe.mark", "args": ["doubleTap"] },
        "doubleTapMs": 400 } },
    { "keys": ">^>!F16", "action": "osd.toggle" },
    { "keys": ">^>!F15", "action": "app.exit" },
    { "keys": ">^>!F13", "action": "app.toggle", "args": ["e2ewin"] },
    { "keys": ">^>!F12", "action": "quickWindow.toggle", "args": ["qw"] },
    { "keys": ">^>!F11", "action": "window.sendBackward" },
    { "keys": ">^>!F10", "action": "window.sendToBack" },
    { "keys": ">^>!F9", "action": "window.bringForward" },
    { "keys": ">^>!F8", "action": "window.bringToFront" },
    { "keys": ">^>!F7", "action": "window.cycleNext" },
    { "keys": ">^>!F6", "action": "window.cyclePrevious" }
    {{EXTRA}}
  ]
}
